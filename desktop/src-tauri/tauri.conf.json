{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Ready Clip",
  "version": "0.1.0",
  "identifier": "com.mmvergara.discordreadyclip",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Discord Ready Clip",
        "width": 1180,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Video",
    "shortDescription": "Trim, crop and compress clips for Discord",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
